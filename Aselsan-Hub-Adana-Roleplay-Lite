	local bankPos = nil
	local bankCFrame = nil
	for _, obj in pairs(Workspace:GetDescendants()) do
		local nameLower = string.lower(obj.Name)
		if string.find(nameLower, "vakıfbank") or string.find(nameLower, "vakifbank") or string.find(nameLower, "vakıf") or string.find(nameLower, "vakif") then
			if obj:IsA("Model") then
				pcall(function() 
					bankCFrame = obj:GetPivot()
					bankPos = bankCFrame.Position 
				end)
				if bankPos then break end
			elseif obj:IsA("BasePart") then
				bankCFrame = obj.CFrame
				bankPos = obj.Position
				break
			end
		end
	end
	
	if bankPos and bankCFrame then
		local frontPos = bankPos + (bankCFrame.LookVector * 18) + Vector3.new(0, 3, 0)
		
