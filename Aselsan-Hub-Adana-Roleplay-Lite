local pEsp = addPage("ESP")
local espEnabled = false
local espBtn
local espConnections = {}
local espRunConn = nil

local function applyEsp(otherPlayer)
	local char = otherPlayer.Character
	if not char then return end
	
	if not char:FindFirstChild("AselsanHighlight") then
		local hl = Instance.new("Highlight")
		hl.Name = "AselsanHighlight"
		hl.Adornee = char
		hl.FillColor = Color3.fromRGB(255, 0, 0)
		hl.FillTransparency = 0.3
		hl.OutlineColor = Color3.fromRGB(255, 0, 0)
		hl.OutlineTransparency = 0
		hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		hl.Parent = char
	end
	
	local head = char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
	if head and not char:FindFirstChild("AselsanEspGui") then
		local billboard = Instance.new("BillboardGui")
		billboard.Name = "AselsanEspGui"
		billboard.Adornee = head
		billboard.Size = UDim2.new(0, 120, 0, 40)
		billboard.StudsOffset = Vector3.new(0, 2.5, 0)
		billboard.AlwaysOnTop = true
		billboard.Parent = char
		
		local nameLbl = Instance.new("TextLabel")
		nameLbl.Name = "NameLabel"
		nameLbl.Size = UDim2.new(1, 0, 0, 20)
		nameLbl.BackgroundTransparency = 1
		nameLbl.Text = otherPlayer.Name
		nameLbl.TextColor3 = Color3.fromRGB(255, 255, 255)
		nameLbl.TextStrokeTransparency = 0
		nameLbl.TextSize = 12
		nameLbl.Font = Enum.Font.GothamBold
		nameLbl.Parent = billboard
		
		local healthLbl = Instance.new("TextLabel")
		healthLbl.Name = "HealthLabel"
		healthLbl.Size = UDim2.new(1, 0, 0, 20)
		healthLbl.Position = UDim2.new(0, 0, 0, 18)
		healthLbl.BackgroundTransparency = 1
		healthLbl.TextColor3 = Color3.fromRGB(0, 255, 0)
		healthLbl.TextStrokeTransparency = 0
		healthLbl.TextSize = 11
		healthLbl.Font = Enum.Font.GothamBold
		healthLbl.Parent = billboard
	end
end

espBtn = addButton(pEsp, "Player ESP (Kapalı)", function()
	espEnabled = not espEnabled
	if espEnabled then
		espBtn.Text = "Player ESP (Açık)"
		for _, p in pairs(Players:GetPlayers()) do
			if p ~= player then
				if p.Character then applyEsp(p) end
				espConnections[p] = p.CharacterAdded:Connect(function(newChar)
					newChar:WaitForChild("HumanoidRootPart", 5)
					if espEnabled then
						task.wait(0.5)
						applyEsp(p)
					end
				end)
			end
		end
		table.insert(espConnections, Players.PlayerAdded:Connect(function(p)
			if p ~= player then
				espConnections[p] = p.CharacterAdded:Connect(function(newChar)
					newChar:WaitForChild("HumanoidRootPart", 5)
					if espEnabled then
						task.wait(0.5)
						applyEsp(p)
					end
				end)
			end
		end))
		
		espRunConn = RunService.RenderStepped:Connect(function()
			if not espEnabled then return end
			for _, p in pairs(Players:GetPlayers()) do
				if p ~= player and p.Character then
					local char = p.Character
					local hum = char:FindFirstChildOfClass("Humanoid")
					local billboard = char:FindFirstChild("AselsanEspGui")
					if hum and billboard then
						local healthLbl = billboard:FindFirstChild("HealthLabel")
						if healthLbl then
							healthLbl.Text = string.format("HP: %d / %d", math.floor(hum.Health), math.floor(hum.MaxHealth))
						end
					else
						applyEsp(p)
					end
				end
			end
		end)
	else
		espBtn.Text = "Player ESP (Kapalı)"
		if espRunConn then
			espRunConn:Disconnect()
			espRunConn = nil
		end
		for _, p in pairs(Players:GetPlayers()) do
			if p.Character then
				local hl = p.Character:FindFirstChild("AselsanHighlight")
				if hl then hl:Destroy() end
				local gui = p.Character:FindFirstChild("AselsanEspGui")
				if gui then gui:Destroy() end
			end
		end
		for _, conn in pairs(espConnections) do
			if typeof(conn) == "RBXScriptConnection" then
				conn:Disconnect()
			end
		end
		espConnections = {}
	end
end)

