RunService.RenderStepped:Connect(function()
	if not hitboxActive then return end
	local sizeVal = tonumber(hitboxSizeBox.Text) or 5
	
	for _, otherPlayer in pairs(Players:GetPlayers()) do
		if otherPlayer ~= player and otherPlayer.Character then
			local char = otherPlayer.Character
			local hrp = char:FindFirstChild("HumanoidRootPart")
			local hum = char:FindFirstChildOfClass("Humanoid")
			
			if hrp and hum then
				-- Eğer oyuncu bir araca bindiyse (oturuyorsa) hitbox'ı normale çevir ki donma/takılma olmasın
				if hum.Sit or hum.SeatPart ~= nil then
					hrp.Size = Vector3.new(2, 2, 1)
					hrp.Transparency = 1
					local hl = char:FindFirstChild("AselsanHitboxHighlight")
					if hl then hl:Destroy() end
