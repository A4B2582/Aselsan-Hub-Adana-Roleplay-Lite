						hbHighlight.Name = "AselsanHitboxHighlight"
						hbHighlight.Adornee = char
						hbHighlight.FillColor = Color3.fromRGB(255, 0, 0)
						hbHighlight.FillTransparency = 0.4
						hbHighlight.OutlineColor = Color3.fromRGB(255, 255, 255)
						hbHighlight.OutlineTransparency = 0
						hbHighlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
						hbHighlight.Parent = char
					end
				end
			end
		end
	end
end)

local aimbotEnabled = false
local aimbotBtn
local aimbotConn = nil

local fovRadius = 150
local fovCircle = Drawing.new("Circle")
fovCircle.Visible = false
fovCircle.Radius = fovRadius
fovCircle.Color = Color3.fromRGB(255, 255, 255)
fovCircle.Thickness = 1
fovCircle.Filled = false
fovCircle.Transparency = 0.7

local function getBestTargetHead()
	local myChar = player.Character
	if not myChar or not myChar:FindFirstChild("HumanoidRootPart") then return nil end
	local cam = Workspace.CurrentCamera
	local screenCenter = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)
	
	local bestHead = nil
	local shortestScreenDist = math.huge
	
	for _, p in pairs(Players:GetPlayers()) do
		if p ~= player and p.Character then
			local hum = p.Character:FindFirstChildOfClass("Humanoid")
			local head = p.Character:FindFirstChild("Head")
			if hum and hum.Health > 0 and head then
				local headScreenPos, onScreen = cam:WorldToViewportPoint(head.Position)
				if onScreen then
					local screenDist = (Vector2.new(headScreenPos.X, headScreenPos.Y) - screenCenter).Magnitude
					if screenDist <= fovRadius and screenDist < shortestScreenDist then
						shortestScreenDist = screenDist
						bestHead = head
					end
				end
			end
		end
	end
	
	return bestHead
end

aimbotBtn = addButton(pHitbox, "Head Aimbot (Kapalı)", function()
	aimbotEnabled = not aimbotEnabled
	if aimbotEnabled then
		aimbotBtn.Text = "Head Aimbot (Açık)"
		fovCircle.Visible = true
		if aimbotConn then aimbotConn:Disconnect() end
		
		aimbotConn = RunService.RenderStepped:Connect(function()
			if not aimbotEnabled then
				fovCircle.Visible = false
				return
			end
			
			local cam = Workspace.CurrentCamera
			fovCircle.Position = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)
			
			local targetHead = getBestTargetHead()
			if targetHead then
				local currentCFrame = cam.CFrame
				local targetCFrame = CFrame.new(currentCFrame.Position, targetHead.Position)
				cam.CFrame = currentCFrame:Lerp(targetCFrame, 0.35)
			end
		end)
	else
		aimbotBtn.Text = "Head Aimbot (Kapalı)"
		fovCircle.Visible = false
		if aimbotConn then
			aimbotConn:Disconnect()
			aimbotConn = nil
		end
	end
end)

