local flyBtn
flyBtn = addButton(pMain, "Fly (Kapalı)", function()
	flying = not flying
	local char = player.Character
	if not char or not char:FindFirstChild("HumanoidRootPart") then
		flying = false
		return
	end
	local hrp = char.HumanoidRootPart
