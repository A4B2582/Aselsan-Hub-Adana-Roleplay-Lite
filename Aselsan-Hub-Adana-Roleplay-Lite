-- --- FARM (Dinamik En Yakın Kasa ve ATM Teleport) ---
local pFarm = addPage("Farm")

local function getSafesList()
	local list = {}
	local myChar = player.Character
	local myPos = (myChar and myChar:FindFirstChild("HumanoidRootPart")) and myChar.HumanoidRootPart.Position or Vector3.new(0,0,0)
	
	for _, obj in pairs(Workspace:GetDescendants()) do
		local nameLower = string.lower(obj.Name)
		if nameLower == "safe" or string.find(nameLower, "kasa") or string.find(nameLower, "safebox") then
			local pos = nil
			if obj:IsA("Model") then
				pcall(function() pos = obj:GetPivot().Position end)
			elseif obj:IsA("BasePart") then
				pos = obj.Position
			end
			
			if pos then
				local isUnique = true
				for _, existingPos in pairs(list) do
					if (existingPos - pos).Magnitude < 6 then
						isUnique = false
						break
					end
				end
				if isUnique then
					table.insert(list, pos)
				end
			end
		end
	end
	
	table.sort(list, function(a, b)
		return (a - myPos).Magnitude < (b - myPos).Magnitude
	end)
	
	return list
end

local safeBtn = addButton(pFarm, "Kasa Teleport (Sıradaki)", function()
	local char = player.Character
	if not char or not char:FindFirstChild("HumanoidRootPart") then return end
	
	local safes = getSafesList()
	if #safes > 0 then
		local targetPos = safes[1]
		if targetPos then
			char.HumanoidRootPart.CFrame = CFrame.new(targetPos + Vector3.new(0, 3, 0))
			safeBtn.Text = string.format("Kasa Teleport (Bulunan: %d)", #safes)
		end
